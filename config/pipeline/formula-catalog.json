      "description": "Standard free cash flow plus signed cash lease payments (an alternative FCF definition that treats lease payments as an operating-like cash outflow)."
    },
    {
      "formula_id": "deferred_revenue_change_contribution", "version": 1, "output_metric_id": "deferred_revenue_change_contribution",
      "category": "cash_generation", "evaluator": "passthrough_with_percent_change",
      "inputs": {"ref": "direct:cf_deferred_revenue_change"},
      "output_unit": "million_usd", "rounding": 1, "change_policy": "percent_of_prior",
      "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["generic", "aviation"],
      "description": "The deferred-revenue change line item from the cash flow statement, carried through as-is with its own year-over-year percent change."
    }
  ]
}
