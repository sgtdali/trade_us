      "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["aviation"],
      "description": "Net financial liability including leases divided by EBITDAR. Quarterly periods use a trailing-twelve-month EBITDAR assembled from four consecutive discrete quarters in the historical series; annual periods use full-year EBITDAR directly."
    },
    {
      "formula_id": "roa", "version": 1, "output_metric_id": "roa",
      "category": "returns", "evaluator": "return_on_average_base",
      "inputs": {"numerator_ref": "direct:net_profit_for_period", "base_ref": "direct:total_assets"},
      "output_unit": "percent", "rounding": 2, "change_policy": "none",
      "applicable_period_kinds": ["annual"],
      "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["generic", "aviation"],
      "description": "Net profit for the period divided by the average of period-start and period-end total assets. Only computed for annual periods; interim periods are marked unavailable rather than annualized."
    },
    {
      "formula_id": "roe", "version": 1, "output_metric_id": "roe",
      "category": "returns", "evaluator": "return_on_average_base",
      "inputs": {"numerator_ref": "direct:net_profit_attributable_parent", "base_ref": "direct:equity_attributable_to_parent"},
      "output_unit": "percent", "rounding": 2, "change_policy": "none",
      "applicable_period_kinds": ["annual"],
      "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["generic", "aviation"],
      "description": "Net profit attributable to parent divided by the average of period-start and period-end equity attributable to parent. Annual periods only."
    },
    {
      "formula_id": "roic", "version": 1, "output_metric_id": "roic",
      "category": "returns", "evaluator": "roic_ratio",
      "inputs": {
        "operating_profit_pre_investment_ref": "direct:operating_profit_before_investment_activities",
        "tax_expense_ref": "direct:tax_expense",
        "profit_before_tax_ref": "direct:profit_before_tax",
        "equity_ref": "direct:total_equity",
        "net_financial_liability_incl_lease_ref": "derived:net_financial_liability_incl_lease"
      },
      "output_unit": "percent", "rounding": 2, "change_policy": "none",
      "applicable_period_kinds": ["annual"],
      "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["generic", "aviation"],
      "description": "NOPAT (pre-investment operating profit taxed at the period's effective tax rate) divided by average invested capital (total equity plus net financial liability including leases, averaged period-start to period-end). Annual periods only."
    },
    {
      "formula_id": "ocf_to_net_profit", "version": 1, "output_metric_id": "ocf_to_net_profit",
      "category": "cash_generation", "evaluator": "ratio",
      "inputs": {"numerator": [{"ref": "direct:cf_net_operating_activities", "sign": 1}], "denominator": [{"ref": "direct:net_profit_for_period", "sign": 1}]},
      "require_positive_denominator": true,
      "output_unit": "ratio", "rounding": 2, "change_policy": "none",
      "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["generic", "aviation"],
      "description": "Net operating cash flow divided by net profit for the period. Undefined (unavailable) when net profit is not positive."
    },
    {
      "formula_id": "capex_to_revenue", "version": 1, "output_metric_id": "capex_to_revenue",
      "category": "cash_generation", "evaluator": "abs_ratio_pct",
      "inputs": {"numerator_ref": "direct:cf_capex_ppe_intangible", "denominator_ref": "direct:revenue_total"},
      "output_unit": "percent", "rounding": 1, "change_policy": "percentage_point",
      "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["generic", "aviation"],
      "description": "Absolute cash capital expenditure as a percentage of total revenue."
    },
    {
      "formula_id": "free_cash_flow", "version": 1, "output_metric_id": "free_cash_flow",
      "category": "cash_generation", "evaluator": "standard_fcf",
      "inputs": {"ocf_ref": "direct:cf_net_operating_activities", "capex_ref": "direct:cf_capex_ppe_intangible"},
      "output_unit": "million_usd", "rounding": 1, "change_policy": "money_points",
      "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["generic", "aviation"],
      "description": "Net operating cash flow plus signed capex cash outflow. Excludes non-cash, directly lease-financed fleet/right-of-use asset additions, which never pass through operating or investing cash flow."
    },
    {
      "formula_id": "free_cash_flow_after_lease_payments", "version": 1, "output_metric_id": "free_cash_flow_after_lease_payments",
