      "inputs": [{"ref": "derived:total_financial_liability_incl_lease", "sign": 1}, {"ref": "direct:cash_and_equivalents", "sign": -1}, {"ref": "direct:financial_investments_current", "sign": -1}, {"ref": "direct:financial_investments_noncurrent", "sign": -1}],
