      "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["generic", "aviation"],
      "description": "Total financial liability including leases divided by total equity."
    },
    {
      "formula_id": "net_debt_to_ebitdar", "version": 1,
      "output_metric_id_by_period_kind": {"quarterly": "net_debt_to_ebitdar_ttm", "annual": "net_debt_to_ebitdar"},
