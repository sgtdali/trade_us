    {"signal_id": "passenger_rask_trend", "rule_id": "dual_growth_confirmation", "rule_version": 1, "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["aviation"], "interpretation_scope": "financial_operational", "source_dataset": "finops", "current_ref": "finops:passenger_rask", "reason_code": "passenger_rask"},
    {"signal_id": "passenger_yield_trend", "rule_id": "dual_growth_confirmation", "rule_version": 1, "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["aviation"], "interpretation_scope": "financial_operational", "source_dataset": "finops", "current_ref": "finops:passenger_yield", "reason_code": "passenger_yield"},
    {"signal_id": "cash_conversion_trend", "rule_id": "cash_conversion_ratio_change", "rule_version": 1, "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["generic", "aviation"], "interpretation_scope": "financial", "source_dataset": "derived", "ratio_ref": "derived:ocf_to_net_profit", "reason_code": "cash_conversion"},
    {"signal_id": "liquidity_trend", "rule_id": "liquidity_composite", "rule_version": 1, "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["generic", "aviation"], "interpretation_scope": "financial", "source_dataset": "derived", "current_ratio_ref": "derived:current_ratio", "cash_ratio_ref": "derived:cash_and_st_investments_to_current_liabilities", "reason_code": "liquidity"},
    {"signal_id": "leverage_trend", "rule_id": "leverage_composite", "rule_version": 1, "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["generic", "aviation"], "interpretation_scope": "financial", "source_dataset": "derived", "liability_ratio_ref": "derived:liability_incl_lease_to_equity", "net_debt_ratio_ref": "derived:net_debt_to_ebitdar", "reason_code": "leverage", "context_policy": {"required_reason_params": ["liability_ratio_change", "net_debt_ratio_change"]}},
