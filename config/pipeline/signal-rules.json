    {"signal_id": "net_margin_trend", "rule_id": "margin_change_band", "rule_version": 1, "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["generic", "aviation"], "interpretation_scope": "financial", "source_dataset": "derived", "margin_ref": "derived:net_margin", "reason_code": "net_margin", "context_policy": {"absolute_ref": "derived:net_margin", "negative_below": 0.0, "positive_above": 0.0}},
