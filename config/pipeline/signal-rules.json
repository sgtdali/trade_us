    {"signal_id": "fuel_unit_cost_trend", "rule_id": "cost_direction", "rule_version": 1, "applicable_company_types": ["standard_corporate"], "applicable_sector_modules": ["aviation"], "interpretation_scope": "financial_operational", "source_dataset": "finops", "current_ref": "finops:fuel_unit_cost", "reason_code": "fuel_unit_cost"},
