{
  "$comment": [
    "Frozen canonical books. Every expected figure below was computed by hand,",
    "which is why the numbers are round: a golden fixture whose expectations were",
    "produced by the code it tests proves only that the code is consistent with",
    "itself. If a change here is 'obviously fine', recompute it on paper first.",
    "Prices are marks, not fills. Weights are fractions of NAV."
  ],
  "books": [
    {
      "name": "all_cash",
      "description": "Nothing owned. Cash is a position, not an absence of one.",
      "events": [
        {"event_type": "opening_cash", "effective_date": "2026-08-01", "cash_amount": "50000"}
      ],
      "prices": {},
      "expected": {
        "nav": "50000",
        "cash": "50000",
        "cash_weight": "1",
        "positions": {},
        "realized_pnl": "0"
      }
    },
    {
      "name": "single_concentrated",
      "description": "One name at 90% of NAV. Legal to hold, impossible to add to.",
      "events": [
        {"event_type": "opening_cash", "effective_date": "2026-08-01", "cash_amount": "10000"},
        {"event_type": "opening_position", "effective_date": "2026-08-01",
         "security_id": "sec:aaa", "quantity": "1000", "cost_basis_status": "known",
         "unit_cost": "80"}
      ],
      "prices": {"sec:aaa": "90"},
      "expected": {
        "nav": "100000",
        "cash": "10000",
        "cash_weight": "0.1",
        "positions": {
          "sec:aaa": {"quantity": "1000", "market_value": "90000", "weight": "0.9",
                      "cost_total": "80000", "unrealized": "10000"}
        },
        "realized_pnl": "0"
      }
    },
    {
      "name": "balanced",
      "description": "Four names at 20% each, 20% cash. The shape the policy expects.",
