          "sec:bbb": {"quantity": "400", "market_value": "20000", "weight": "0.2",
                      "cost_total": "18000", "unrealized": "2000"},
          "sec:ccc": {"quantity": "100", "market_value": "20000", "weight": "0.2",
                      "cost_total": "18000", "unrealized": "2000"},
          "sec:ddd": {"quantity": "1000", "market_value": "20000", "weight": "0.2",
                      "cost_total": "18000", "unrealized": "2000"}
