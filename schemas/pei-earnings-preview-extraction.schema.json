{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trade-us.local/schemas/pei-earnings-preview-extraction.schema.json",
  "title": "PEI earnings-preview extraction (agy structured output)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expectation_bar", "stock_moving_kpis", "position_action",
    "call_question_falsifiers", "next_route"
  ],
  "properties": {
    "next_route": {"type": ["string", "null"]},
    "expectation_bar": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "threshold"],
        "properties": {
          "metric": {"type": "string"},
          "threshold": {"type": "string"}
        }
      }
    },
    "stock_moving_kpis": {
      "type": "array",
      "items": {"type": "string"}
    },
    "position_action": {"type": ["string", "null"]},
    "call_question_falsifiers": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
