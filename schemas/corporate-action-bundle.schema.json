{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "valuation-pipeline:schemas/corporate-action-bundle.schema.json",
  "title": "Corporate-action bundle",
  "description": "A governed, generated (never authored directly) transport of corporate-action events promoted from a share-count ledger, consumable by T70's market resolver via the optional --corporate-actions argument. Deliberately a separate artifact rather than a fourth MarketObservation.observation_type -- see fundamental_pipeline.valuation.ingestion.share_count and docs/eregl-point-in-time-share-count-governance.md.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "ticker",
    "instrument_id",
    "as_of_date",
    "cutoff_instant",
    "coverage",
    "events",
    "source_manifest_refs"
  ],
  "properties": {
    "schema_version": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/semver"
    },
    "artifact_type": {
      "const": "corporate_action_bundle"
    },
    "ticker": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/ticker"
    },
    "instrument_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of_date": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"
    },
    "cutoff_instant": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/utcInstant"
    },
    "coverage": {
      "type": "object",
      "required": [
        "coverage_start_date",
        "coverage_end_date",
        "coverage_status",
        "reviewed_at",
        "review_method",
        "reviewed_source_refs",
        "unresolved_gap_refs"
      ],
      "properties": {
        "coverage_start_date": {
          "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"
        },
        "coverage_end_date": {
          "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"
        },
        "coverage_status": {
          "type": "string",
          "enum": [
            "complete",
            "gap",
            "unknown"
          ]
        },
        "reviewed_at": {
          "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/utcInstant"
        },
        "review_method": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved_gap_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/promotedCorporateActionEvent"
      }
    },
    "source_manifest_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "manifest_id",
          "manifest_version"
        ],
        "properties": {
          "manifest_id": {
            "type": "string",
            "minLength": 1
          },
          "manifest_version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "promotedCorporateActionEvent": {
      "type": "object",
      "required": [
        "event_id",
        "event_type",
        "instrument_id",
        "available_at",
        "effective_date",
        "status",
        "source_manifest_id",
        "revision_status"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "enum": [
            "split",
            "reverse_split",
            "capital_increase",
            "capital_reduction",
            "treasury_purchase",
            "treasury_sale",
            "cancellation",
            "class_conversion",
            "other"
          ]
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1
        },
        "announcement_at": {
          "anyOf": [
            {
              "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/utcInstant"
            },
            {
              "type": "null"
            }
          ]
        },
        "available_at": {
          "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/utcInstant"
        },
        "effective_date": {
          "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"
        },
        "status": {
          "type": "string",
          "enum": [
            "announced",
            "approved",
            "effective",
            "cancelled",
            "unknown"
          ]
        },
        "source_manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "source_record_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision_status": {
          "type": "string",
          "enum": [
            "original",
            "corrected",
            "restated",
            "withdrawn",
            "unknown"
          ]
        },
        "pre_issued_quote_units": {
          "anyOf": [
            {
              "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/nonNegativeDecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "post_issued_quote_units": {
          "anyOf": [
            {
              "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/nonNegativeDecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "pre_treasury_quote_units": {
          "anyOf": [
            {
              "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/nonNegativeDecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "post_treasury_quote_units": {
          "anyOf": [
            {
              "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/nonNegativeDecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "adjustment_ratio": {
          "anyOf": [
            {
              "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/decimalString"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
