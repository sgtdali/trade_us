{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "valuation-pipeline:schemas/valuation-catalog.schema.json",
  "title": "Valuation catalog envelope",
  "type": "object",
  "required": ["schema_version", "catalog_id", "catalog_version", "lifecycle_status", "effective_from", "entries"],
  "properties": {
    "schema_version": {"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/semver"},
    "catalog_id": {"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/catalogId"},
    "catalog_version": {"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/semver"},
    "lifecycle_status": {"type": "string", "enum": ["draft", "approved", "deprecated", "retired"]},
    "effective_from": {"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"},
    "effective_to": {"type": ["string", "null"]},
    "source_contract_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/catalogEntry"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "catalogEntry": {
      "type": "object",
      "required": ["entry_id", "entry_version", "lifecycle_status"],
      "properties": {
        "entry_id": {"type": "string", "minLength": 1},
        "entry_version": {"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/semver"},
        "lifecycle_status": {"type": "string", "enum": ["draft", "approved", "deprecated", "retired"]},
        "label": {"type": "string"},
        "source_contract_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "body": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
