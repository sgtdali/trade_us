{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "valuation-pipeline:schemas/holding-assets.schema.json",
  "title": "Holding asset evidence ledger",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "owner_type",
    "ticker",
    "period",
    "period_end",
    "reporting_currency",
    "materiality_threshold",
    "assets",
    "parent_only_financial_position",
    "consolidated_financial_position",
    "reconciliations",
    "lineage"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "holding_assets"},
    "owner_type": {"enum": ["authored", "extracted"]},
    "ticker": {"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/ticker"},
    "period": {"type": "string", "minLength": 1},
    "period_end": {"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"},
    "reporting_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "materiality_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/asset"}
    },
    "parent_only_financial_position": {"$ref": "#/$defs/financialPosition"},
    "consolidated_financial_position": {"$ref": "#/$defs/financialPosition"},
    "reconciliations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reconciliation_id", "scope", "status", "reported_total", "asset_ids", "difference", "evidence"],
        "properties": {
          "reconciliation_id": {"type": "string", "minLength": 1},
          "scope": {"enum": ["parent_only_investments", "equity_accounted_investments", "other"]},
          "status": {"enum": ["passed", "failed", "not_available"]},
          "reported_total": {"$ref": "#/$defs/amount"},
          "asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "difference": {"$ref": "#/$defs/amount"},
          "evidence": {"anyOf": [{"$ref": "#/$defs/evidence"}, {"type": "null"}]}
        },
        "additionalProperties": false
      }
    },
    "lineage": {"$ref": "#/$defs/lineage"}
  },
  "additionalProperties": false,
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "evidence": {
      "type": "object",
      "required": ["source_id", "source_file", "page", "quoted_text"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_file": {"type": "string", "minLength": 1},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "quoted_text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "amount": {
      "type": "object",
      "required": ["status", "value", "currency", "value_date", "evidence", "reason_codes"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "value": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "value_date": {"anyOf": [{"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"}, {"type": "null"}]},
        "evidence": {"anyOf": [{"$ref": "#/$defs/evidence"}, {"type": "null"}]},
        "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "available"}}},
          "then": {
            "properties": {
              "value": {"$ref": "#/$defs/decimal"},
              "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
              "value_date": {"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"},
              "evidence": {"$ref": "#/$defs/evidence"}
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "required": [
        "economic_asset_id",
        "name",
        "asset_type",
        "consolidation_method",
        "ownership_pct",
        "listed_ticker",
        "total_quote_units",
        "included_in_asset_id",
        "book_value",
        "disclosed_value",
        "materiality_proxy",
        "evidence"
      ],
      "properties": {
        "economic_asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "name": {"type": "string", "minLength": 1},
        "asset_type": {"enum": ["listed_subsidiary", "listed_investment", "unlisted_subsidiary", "associate", "joint_venture", "direct_asset", "other"]},
        "consolidation_method": {"enum": ["full", "equity_method", "cost", "fair_value", "not_consolidated", "unknown"]},
        "ownership_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "listed_ticker": {"type": ["string", "null"], "pattern": "^[A-Z0-9.-]+$"},
        "total_quote_units": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "included_in_asset_id": {"type": ["string", "null"]},
        "book_value": {"$ref": "#/$defs/amount"},
        "disclosed_value": {"$ref": "#/$defs/amount"},
        "materiality_proxy": {"$ref": "#/$defs/amount"},
        "evidence": {"$ref": "#/$defs/evidence"}
      },
      "additionalProperties": false
    },
    "financialPosition": {
      "type": "object",
      "required": ["cash", "financial_debt", "other_adjustments"],
      "properties": {
        "cash": {"$ref": "#/$defs/amount"},
        "financial_debt": {"$ref": "#/$defs/amount"},
        "net_cash": {"$ref": "#/$defs/amount"},
        "other_adjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["adjustment_id", "label", "amount"],
            "properties": {
              "adjustment_id": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "amount": {"$ref": "#/$defs/amount"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": ["source_ids", "generated_at", "generator"],
      "properties": {
        "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "generated_at": {"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/utcInstant"},
        "generator": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
