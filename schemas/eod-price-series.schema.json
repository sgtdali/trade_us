{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "valuation-pipeline:schemas/eod-price-series.schema.json",
  "title": "Normalized EOD price series",
  "description": "Strict internal daily-bar contract produced by normalizing one eod-provider-extract. Distinguishes unadjusted 'close' from provider-supplied 'adjusted_close'; never claims either is an official Borsa Istanbul price and is never itself connected to a T70 market snapshot.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "provider_id",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/semver"
    },
    "artifact_type": {
      "const": "eod_price_series"
    },
    "provider_id": {
      "const": "yfinance"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eodRow"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fieldValue": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "value": {
          "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/decimalString"
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            },
            "required": [
              "reason_code"
            ]
          }
        }
      ]
    },
    "sourceRowReference": {
      "description": "Stable source-row identity per docs Section 14 -- deliberately excludes retrieval time.",
      "type": "object",
      "required": [
        "provider_id",
        "provider_symbol",
        "trade_date",
        "interval"
      ],
      "properties": {
        "provider_id": {
          "const": "yfinance"
        },
        "provider_symbol": {
          "type": "string",
          "minLength": 1
        },
        "trade_date": {
          "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"
        },
        "interval": {
          "const": "1d"
        }
      },
      "additionalProperties": false
    },
    "eodRow": {
      "type": "object",
      "required": [
        "internal_ticker",
        "provider_symbol",
        "trade_date",
        "currency",
        "open",
        "high",
        "low",
        "close",
        "adjusted_close",
        "volume",
        "dividend",
        "stock_split",
        "row_status",
        "quarantine_reason_codes",
        "source_row_reference"
      ],
      "properties": {
        "internal_ticker": {
          "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/ticker"
        },
        "provider_symbol": {
          "type": "string",
          "minLength": 1
        },
        "trade_date": {
          "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "open": {
          "$ref": "#/$defs/fieldValue"
        },
        "high": {
          "$ref": "#/$defs/fieldValue"
        },
        "low": {
          "$ref": "#/$defs/fieldValue"
        },
        "close": {
          "$ref": "#/$defs/fieldValue"
        },
        "adjusted_close": {
          "$ref": "#/$defs/fieldValue"
        },
        "volume": {
          "$ref": "#/$defs/fieldValue"
        },
        "dividend": {
          "$ref": "#/$defs/fieldValue"
        },
        "stock_split": {
          "$ref": "#/$defs/fieldValue"
        },
        "row_status": {
          "type": "string",
          "enum": [
            "valid",
            "quarantined"
          ]
        },
        "quarantine_reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_row_reference": {
          "$ref": "#/$defs/sourceRowReference"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "row_status": {
                "const": "quarantined"
              }
            },
            "required": [
              "row_status"
            ]
          },
          "then": {
            "properties": {
              "quarantine_reason_codes": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "row_status": {
                "const": "valid"
              }
            },
            "required": [
              "row_status"
            ]
          },
          "then": {
            "properties": {
              "quarantine_reason_codes": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
