{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "valuation-pipeline:schemas/share-count-promotion-manifest.schema.json",
  "title": "Share-count promotion manifest",
  "description": "Governed result of one share-count promotion run: exact ledger/manifest/policy lineage, selected records, reconciled outstanding-share value, and output-file hashes. A partial promotion bundle is never described as overall_status='valid'.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "promotion_id",
    "ticker",
    "as_of_date",
    "cutoff_instant",
    "selected_issued_record_id",
    "selected_treasury_record_id",
    "issued_quote_units",
    "treasury_quote_units",
    "spot_basic_shares_outstanding_quote_units",
    "source_ledger_ref",
    "share_manifest_ref",
    "corporate_action_manifest_ref",
    "promotion_policy_ref",
    "output_files",
    "overall_status",
    "finding_counts"
  ],
  "properties": {
    "schema_version": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/semver"
    },
    "artifact_type": {
      "const": "share_count_promotion_manifest"
    },
    "promotion_id": {
      "type": "string",
      "minLength": 1
    },
    "ticker": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/ticker"
    },
    "as_of_date": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"
    },
    "cutoff_instant": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/utcInstant"
    },
    "selected_issued_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_treasury_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "issued_quote_units": {
      "anyOf": [
        {
          "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/nonNegativeDecimalString"
        },
        {
          "type": "null"
        }
      ]
    },
    "treasury_quote_units": {
      "anyOf": [
        {
          "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/nonNegativeDecimalString"
        },
        {
          "type": "null"
        }
      ]
    },
    "spot_basic_shares_outstanding_quote_units": {
      "anyOf": [
        {
          "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/nonNegativeDecimalString"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_ledger_ref": {
      "type": "object",
      "required": [
        "ledger_id",
        "ledger_version"
      ],
      "properties": {
        "ledger_id": {
          "type": "string",
          "minLength": 1
        },
        "ledger_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "share_manifest_ref": {
      "type": "object",
      "required": [
        "manifest_id",
        "manifest_version"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "corporate_action_manifest_ref": {
      "type": "object",
      "required": [
        "manifest_id",
        "manifest_version"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "promotion_policy_ref": {
      "type": "object",
      "required": [
        "policy_id",
        "policy_version"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "output_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relative_path"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "valid",
        "invalid"
      ]
    },
    "finding_counts": {
      "type": "object",
      "required": [
        "blocker",
        "error",
        "warning",
        "info"
      ],
      "properties": {
        "blocker": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
