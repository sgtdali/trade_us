{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "valuation-pipeline:schemas/fx-ingestion-bundle.schema.json",
  "title": "FX ingestion bundle manifest",
  "description": "The manifest for one immutable FX ingestion run bundle: which files it contains, their content hashes, and a summary of the run outcome. overall_status='valid' only when every requested pair produced a structurally valid provider extract, at least one valid close row exists per pair, and no blocking/error finding was raised -- a partial run is never silently promoted as valid.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "provider_id",
    "provider_library_version",
    "requested_pairs",
    "overall_status",
    "valid_row_count",
    "quarantined_row_count",
    "finding_counts",
    "bundle_files"
  ],
  "properties": {
    "schema_version": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/semver"
    },
    "artifact_type": {
      "const": "fx_ingestion_bundle"
    },
    "provider_id": {
      "const": "yfinance"
    },
    "provider_library_version": {
      "type": "string",
      "minLength": 1
    },
    "requested_pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{3}/[A-Z]{3}$"
      }
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "valid",
        "invalid"
      ]
    },
    "valid_row_count": {
      "type": "integer",
      "minimum": 0
    },
    "quarantined_row_count": {
      "type": "integer",
      "minimum": 0
    },
    "finding_counts": {
      "type": "object",
      "required": [
        "blocker",
        "error",
        "warning",
        "info"
      ],
      "properties": {
        "blocker": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "bundle_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "relative_path"
        ],
        "properties": {
          "relative_path": {
            "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/relativePath"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
