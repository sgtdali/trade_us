{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fundemental-trading/schemas/source-manifest.schema.json",
  "title": "Source manifest",
  "type": "object",
  "required": ["schema_version", "ticker", "sources"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9.\\-]+$"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "path", "source_type", "is_primary"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^raw/"},
          "source_type": {"type": "string"},
          "language": {"type": ["string", "null"]},
          "publication_date": {"type": ["string", "null"]},
          "periods_covered": {"type": "array", "items": {"type": "string"}},
          "currency": {"type": ["string", "null"]},
          "scale": {"type": ["string", "null"]},
          "consolidation": {"type": ["string", "null"]},
          "audit_status": {"type": ["string", "null"]},
          "accounting_basis": {"type": ["string", "null"]},
          "is_primary": {"type": "boolean"},
          "sha256": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
