{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "valuation-pipeline:schemas/eod-close-promotion-manifest.schema.json",
  "title": "EOD-close promotion manifest",
  "description": "Governed result of one promotion run: exact source-bundle/manifest/policy lineage, the selected trade date, and output-file hashes. A partial promotion bundle is never described as overall_status='valid'.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "promotion_id",
    "provider_id",
    "ticker",
    "as_of_date",
    "cutoff_instant",
    "selected_trade_date",
    "selected_price_field",
    "price_mode",
    "source_bundle",
    "market_source_manifest_ref",
    "promotion_policy_ref",
    "output_files",
    "overall_status",
    "finding_counts"
  ],
  "properties": {
    "schema_version": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/semver"
    },
    "artifact_type": {
      "const": "eod_close_promotion_manifest"
    },
    "promotion_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "ticker": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/ticker"
    },
    "as_of_date": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"
    },
    "cutoff_instant": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/utcInstant"
    },
    "selected_trade_date": {
      "oneOf": [
        {
          "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"
        },
        {
          "type": "null"
        }
      ]
    },
    "selected_price_field": {
      "const": "close"
    },
    "price_mode": {
      "const": "official_close"
    },
    "source_bundle": {
      "type": "object",
      "required": [
        "bundle_files"
      ],
      "properties": {
        "bundle_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "relative_path"
            ],
            "properties": {
              "relative_path": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "market_source_manifest_ref": {
      "type": "object",
      "required": [
        "manifest_id",
        "manifest_version"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "promotion_policy_ref": {
      "type": "object",
      "required": [
        "policy_id",
        "policy_version"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "output_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relative_path"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "valid",
        "invalid"
      ]
    },
    "finding_counts": {
      "type": "object",
      "required": [
        "blocker",
        "error",
        "warning",
        "info"
      ],
      "properties": {
        "blocker": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
