{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "valuation-pipeline:schemas/fx-close-promotion-policy.schema.json",
  "title": "FX-close promotion policy",
  "description": "Governs the FX-close-to-T70-observation promotion bridge: the selected price field, the fx_mode, the timestamp-proxy rules for published_at/available_at, and the maximum fallback lag. Structurally parallel to eod-close-promotion-policy.schema.json. fx_mode is fixed to 'market_close' -- this bridge promotes only an unadjusted daily close as a market-close-timed reference rate, never a claimed central-bank daily benchmark. effective_at_source is fixed to 'explicit_cli_argument' because no verified FX market-close convention is governed yet (see effective_at_verification_note and docs/yfinance-eod-pilot.md).",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "policy_id",
    "policy_version",
    "effective_at_source",
    "effective_at_verification_note",
    "max_fallback_lag_days",
    "selected_price_field",
    "fx_mode",
    "timestamp_proxy_rules"
  ],
  "properties": {
    "schema_version": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/semver"
    },
    "artifact_type": {
      "const": "fx_close_promotion_policy"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/semver"
    },
    "effective_at_source": {
      "const": "explicit_cli_argument"
    },
    "effective_at_verification_note": {
      "type": "string",
      "minLength": 1
    },
    "max_fallback_lag_days": {
      "type": "integer",
      "minimum": 0
    },
    "selected_price_field": {
      "const": "close"
    },
    "fx_mode": {
      "const": "market_close"
    },
    "timestamp_proxy_rules": {
      "type": "object",
      "required": [
        "available_at_source",
        "published_at_source"
      ],
      "properties": {
        "available_at_source": {
          "const": "fx_provider_extract.retrieved_at"
        },
        "published_at_source": {
          "const": "fx_provider_extract.retrieved_at"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
