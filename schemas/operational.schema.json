{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fundemental-trading/schemas/operational.schema.json",
  "title": "Raw monthly/YTD operational traffic data",
  "type": "object",
  "required": ["schema_version", "ticker", "period", "metrics"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9.\\-]+$"},
    "period": {"type": "string"},
    "source": {"type": "object"},
    "coverage": {"type": "object"},
    "headline": {"type": "object"},
    "version": {"type": "integer"},
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_id", "value", "unit"],
        "properties": {
          "metric_id": {"type": "string"},
          "period_type": {"type": ["string", "null"]},
          "scope": {"type": ["string", "null"]},
          "region": {"type": ["string", "null"]},
          "value": {"type": ["number", "null"]},
          "unit": {"type": "string"},
          "comparison_value": {"type": ["number", "null"]},
          "comparison_period": {"type": ["string", "null"]},
          "change": {"type": ["number", "null"]},
          "change_unit": {"type": ["string", "null"]},
          "is_ytd": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
