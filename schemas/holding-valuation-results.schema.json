{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "valuation-pipeline:schemas/holding-valuation-results.schema.json",
  "title": "Deterministic holding NAV/SOTP results",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "owner_type",
    "ticker",
    "as_of_date",
    "reporting_currency",
    "model_id",
    "input_ref",
    "asset_rows",
    "nav_bridge",
    "per_share_nav",
    "observed_discount_premium",
    "valuation_basis_mix",
    "coverage",
    "blocker_codes",
    "lineage"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "holding_valuation_results"},
    "owner_type": {"const": "generated"},
    "ticker": {"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/ticker"},
    "as_of_date": {"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"},
    "reporting_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "model_id": {"const": "holding_nav_sotp_v1"},
    "input_ref": {"type": "string", "minLength": 1},
    "asset_rows": {"type": "array", "items": {"$ref": "valuation-pipeline:schemas/holding-valuation-inputs.schema.json#/$defs/resolvedAsset"}},
    "nav_bridge": {"$ref": "#/$defs/navBridge"},
    "per_share_nav": {"$ref": "#/$defs/resultValue"},
    "observed_discount_premium": {"$ref": "#/$defs/resultValue"},
    "valuation_basis_mix": {
      "type": "object",
      "required": ["listed_market_value", "disclosed_value", "book_value"],
      "properties": {
        "listed_market_value": {"$ref": "#/$defs/decimal"},
        "disclosed_value": {"$ref": "#/$defs/decimal"},
        "book_value": {"$ref": "#/$defs/decimal"}
      },
      "additionalProperties": false
    },
    "coverage": {"$ref": "valuation-pipeline:schemas/holding-valuation-inputs.schema.json#/$defs/coverage"},
    "blocker_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "lineage": {"$ref": "valuation-pipeline:schemas/holding-assets.schema.json#/$defs/lineage"}
  },
  "additionalProperties": false,
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "resultValue": {
      "type": "object",
      "required": ["status", "value", "unit", "reason_codes"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "value": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "unit": {"type": "string", "minLength": 1},
        "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "navBridge": {
      "type": "object",
      "required": ["status", "attributable_asset_value", "parent_cash", "parent_financial_debt", "parent_net_cash", "other_adjustments", "total_nav", "reason_codes"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "attributable_asset_value": {"$ref": "#/$defs/decimal"},
        "parent_cash": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "parent_financial_debt": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "parent_net_cash": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "other_adjustments": {"$ref": "#/$defs/decimal"},
        "total_nav": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  }
}
