{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "valuation-pipeline:schemas/holding-valuation-inputs.schema.json",
  "title": "Point-in-time holding NAV inputs",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "owner_type",
    "ticker",
    "as_of_date",
    "cutoff_instant",
    "reporting_currency",
    "asset_ledger_ref",
    "resolved_assets",
    "parent_only_financial_position",
    "consolidated_financial_position",
    "share_basis",
    "holding_market",
    "materiality_threshold",
    "coverage",
    "lineage"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "holding_valuation_inputs"},
    "owner_type": {"const": "generated"},
    "ticker": {"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/ticker"},
    "as_of_date": {"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"},
    "cutoff_instant": {"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/utcInstant"},
    "reporting_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "asset_ledger_ref": {"type": "string", "minLength": 1},
    "resolved_assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/resolvedAsset"}
    },
    "parent_only_financial_position": {"$ref": "valuation-pipeline:schemas/holding-assets.schema.json#/$defs/financialPosition"},
    "consolidated_financial_position": {"$ref": "valuation-pipeline:schemas/holding-assets.schema.json#/$defs/financialPosition"},
    "share_basis": {"$ref": "#/$defs/shareBasis"},
    "holding_market": {"$ref": "#/$defs/holdingMarket"},
    "materiality_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "coverage": {"$ref": "#/$defs/coverage"},
    "lineage": {"$ref": "valuation-pipeline:schemas/holding-assets.schema.json#/$defs/lineage"}
  },
  "additionalProperties": false,
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "resolvedAsset": {
      "type": "object",
      "required": [
        "economic_asset_id",
        "name",
        "status",
        "valuation_basis",
        "ownership_pct",
        "gross_value",
        "attributable_value",
        "value_date",
        "materiality_proxy",
        "included_in_asset_id",
        "source_refs",
        "reason_codes"
      ],
      "properties": {
        "economic_asset_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["available", "unavailable", "excluded"]},
        "valuation_basis": {"enum": ["listed_market_value", "disclosed_value", "book_value", "unavailable", "included_in_parent"]},
        "ownership_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "gross_value": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "attributable_value": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "value_date": {"anyOf": [{"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"}, {"type": "null"}]},
        "materiality_proxy": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "included_in_asset_id": {"type": ["string", "null"]},
        "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "shareBasis": {
      "type": "object",
      "required": ["status", "issued_shares", "treasury_shares", "outstanding_shares", "source_refs", "reason_codes"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "issued_shares": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "treasury_shares": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "outstanding_shares": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "holdingMarket": {
      "type": "object",
      "required": ["status", "price", "trade_date", "market_cap", "source_refs", "reason_codes"],
      "properties": {
        "status": {"enum": ["available", "unavailable"]},
        "price": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "trade_date": {"anyOf": [{"$ref": "valuation-pipeline:schemas/valuation-common.schema.json#/$defs/isoDate"}, {"type": "null"}]},
        "market_cap": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
        "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["identified_proxy_value", "unresolved_proxy_value", "unresolved_ratio", "status", "blocker_codes"],
      "properties": {
        "identified_proxy_value": {"$ref": "#/$defs/decimal"},
        "unresolved_proxy_value": {"$ref": "#/$defs/decimal"},
        "unresolved_ratio": {
          "anyOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        },
        "status": {"enum": ["sufficient", "insufficient"]},
        "blocker_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  }
}
