{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "US direct official company decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "yargi", "alinmaz_nedeni", "tez", "tez_testleri",
    "belirleyici_veriler", "tezi_bozacak_kosullar", "belirsizlik",
    "guven", "gerekce"
  ],
  "properties": {
    "yargi": {"enum": ["tez_var", "sartli", "alinmaz"]},
    "alinmaz_nedeni": {
      "type": ["string", "null"],
      "enum": [null, "veri_guvensiz", "finansal_kirilganlik", "tez_yok", "degerleme_desteksiz", "belirsizlik_asiri"]
    },
    "tez": {"type": "string"},
    "tez_testleri": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "baseline", "expected_direction", "deadline_period", "failure_condition"],
        "properties": {
          "metric_id": {"type": "string"},
          "baseline": {"type": "number"},
          "expected_direction": {"enum": ["increase", "decrease", "stay_above", "stay_below"]},
          "deadline_period": {"type": "string", "pattern": "^20[0-9]{2}-(Q[1-4]|FY)$"},
          "failure_condition": {"type": "string"}
        }
      }
    },
    "belirleyici_veriler": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tur", "reported_value", "report_section", "alinti", "aciklama"],
        "properties": {
          "tur": {"enum": ["sayisal", "anlati"]},
          "reported_value": {"type": ["number", "null"]},
          "report_section": {"type": "string"},
          "alinti": {"type": ["string", "null"]},
          "aciklama": {"type": "string"}
        }
      }
    },
    "tezi_bozacak_kosullar": {"type": "array", "items": {"type": "string"}},
    "belirsizlik": {"type": "array", "items": {"type": "string"}},
    "guven": {"enum": ["dusuk", "orta", "yuksek"]},
    "gerekce": {"type": "string"}
  }
}
