{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "US direct company attractiveness score",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score", "gerekce", "belirleyici_veriler", "belirsizlik"
  ],
  "properties": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Attractiveness against the anchored bands in the prompt. Not a return forecast."
    },
    "gerekce": {"type": "string"},
    "belirleyici_veriler": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tur", "reported_value", "report_section", "alinti", "aciklama"],
        "properties": {
          "tur": {"enum": ["sayisal", "anlati"]},
          "reported_value": {"type": ["number", "null"]},
          "report_section": {"type": "string"},
          "alinti": {"type": ["string", "null"]},
          "aciklama": {"type": "string"}
        }
      }
    },
    "belirsizlik": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
